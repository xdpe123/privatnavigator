{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "privatnavigator",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "WATCHES", "class_name": "TripWatches" },
      { "name": "API_USAGE", "class_name": "ApiUsage" },
      { "name": "TRIP_HISTORY", "class_name": "TripHistory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TripWatches"] },
    { "tag": "v2", "new_sqlite_classes": ["ApiUsage"] },
    { "tag": "v3", "new_sqlite_classes": ["TripHistory"] }
  ]
}
